<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>智能颜色转换器 </title>
    
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google 字体 -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <!-- 引入 Font Awesome 图标 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: #05070a;
            color: #e2e8f0;
            overflow-x: hidden;
            margin: 0;
            min-height: 100vh;
        }

        /* 太空背景动画 */
        .stars-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: radial-gradient(circle at center, #111827 0%, #05070a 100%);
            overflow: hidden;
        }

        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            opacity: 0.5;
            animation: twinkle var(--duration) infinite ease-in-out;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); box-shadow: 0 0 8px rgba(255,255,255,0.8); }
        }

        /* 玻璃拟态卡片优化 */
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(59, 130, 246, 0.1);
        }

        /* 霓虹文字效果 */
        .neon-text {
            text-shadow: 0 0 15px rgba(59, 130, 246, 0.6);
            background: linear-gradient(135deg, #60a5fa, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* 自定义文本域与滚动条 */
        textarea {
            font-family: 'Fira Code', monospace;
            letter-spacing: 0.5px;
        }
        
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(59, 130, 246, 0.5);
        }

        /* 动态生成的未映射标签暗黑适配 */
        .unmapped-list {
            background: rgba(0, 0, 0, 0.3);
            border: 1px inset rgba(255, 255, 255, 0.05);
            padding: 16px;
            border-radius: 12px;
            max-height: 180px;
            overflow-y: auto;
        }

        .unmapped-item {
            background: rgba(245, 158, 11, 0.1);
            color: #fcd34d;
            border: 1px solid rgba(245, 158, 11, 0.3);
            display: inline-block;
            margin: 4px 8px 4px 0;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 13px;
            font-family: 'Fira Code', monospace;
            transition: all 0.2s;
        }
        
        .unmapped-item:hover {
            background: rgba(245, 158, 11, 0.2);
            border-color: rgba(245, 158, 11, 0.6);
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
        }

        /* 按钮特效 */
        .btn-neon {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.5);
            color: #60a5fa;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
        }
        .btn-neon:hover {
            background: rgba(59, 130, 246, 0.25);
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
            transform: translateY(-2px);
        }
        
        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #e2e8f0;
        }
        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .copy-success {
            background: rgba(16, 185, 129, 0.2) !important;
            border-color: #10b981 !important;
            color: #34d399 !important;
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.3) !important;
        }
    </style>
</head>
<body>

<!-- 星空背景 -->
<div id="stars" class="stars-container"></div>

<div class="container mx-auto px-4 py-12 relative z-10 max-w-7xl">
    
    <!-- 头部区域 -->
    <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-4 neon-text italic uppercase">
            🎨 智能颜色标准化转换器
        </h1>
        <p class="text-gray-400 text-sm md:text-base font-light tracking-widest uppercase mb-4">
            批量映射颜色名称 · 支持拼写纠错 · 模糊匹配 · 新增单字母/Multicolor系列/Wine映射
        </p>
        <div class="flex flex-wrap justify-center gap-3 text-xs font-bold uppercase tracking-widest text-gray-400">
            <span class="px-3 py-1 border border-blue-500/30 rounded-full bg-blue-500/10"><span class="text-blue-400 mr-1">●</span> Exact Match</span>
            <span class="px-3 py-1 border border-purple-500/30 rounded-full bg-purple-500/10"><span class="text-purple-400 mr-1">●</span> Fuzzy Logic</span>
            <span class="px-3 py-1 border border-green-500/30 rounded-full bg-green-500/10"><span class="text-green-400 mr-1">●</span> Auto Correction</span>
        </div>
    </div>

    <!-- 转换器面板 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- 输入区 -->
        <div class="glass-card rounded-2xl overflow-hidden flex flex-col relative group">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-600/20 transition-all"></div>
            <div class="flex justify-between items-center px-6 py-4 border-b border-white/10 bg-black/20">
                <span class="font-semibold text-gray-200">📥 原始颜色列表</span>
                <span class="text-[0.7rem] px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30">每行一个颜色</span>
            </div>
            <textarea id="inputColors" class="w-full h-96 p-6 bg-transparent text-gray-300 outline-none resize-y focus:bg-white/5 transition-colors" placeholder="例如：
mint green
rose gold
champagne
A
B
C
color
colorful
as show
As shown
mul
Wine
balck
whtie
while
MulticolorXYZ
Mixed colors
navy blue
bluw"></textarea>
        </div>

        <!-- 输出区 -->
        <div class="glass-card rounded-2xl overflow-hidden flex flex-col relative group">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-purple-600/10 rounded-full blur-3xl group-hover:bg-purple-600/20 transition-all"></div>
            <div class="flex justify-between items-center px-6 py-4 border-b border-white/10 bg-black/20">
                <span class="font-semibold text-gray-200">✨ 转换结果 (标准颜色)</span>
                <span class="text-[0.7rem] px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">每行一个，可复制到Excel</span>
            </div>
            <textarea id="outputColors" readonly class="w-full h-96 p-6 bg-transparent text-gray-200 outline-none resize-y" placeholder="点击【开始转换】后显示结果..."></textarea>
        </div>
    </div>

    <!-- 操作栏 -->
    <div class="flex justify-center gap-4 mb-10 flex-wrap">
        <button id="convertBtn" class="btn-neon px-6 py-3 rounded-full font-bold text-sm tracking-wide transition-all flex items-center gap-2">
            <i class="fa-solid fa-rotate"></i> 🔄 开始转换 & 识别未映射颜色
        </button>
        <button id="copyBtn" class="btn-glass px-6 py-3 rounded-full font-semibold text-sm transition-all flex items-center gap-2">
            <i class="fa-regular fa-clipboard"></i> 📋 复制转换结果
        </button>
        <button id="clearBtn" class="btn-glass px-6 py-3 rounded-full font-semibold text-sm transition-all flex items-center gap-2 hover:text-red-400 hover:border-red-400/50 hover:bg-red-500/10">
            <i class="fa-regular fa-trash-can"></i> 🗑️ 清空所有
        </button>
    </div>

    <!-- 未映射颜色提示区 -->
    <div class="glass-card rounded-2xl p-6 md:p-8 relative overflow-hidden group">
        <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-yellow-600/10 rounded-full blur-3xl transition-all"></div>
        
        <div class="flex flex-wrap justify-between items-center pb-4 border-b border-white/10 mb-5 gap-4 relative z-10">
            <div class="flex items-center gap-3">
                <span class="font-bold text-gray-200">⚠️ 未映射的颜色 (保留原值)</span>
                <span id="unmappedCount" class="bg-gray-800 text-gray-300 text-xs px-3 py-1 rounded-full border border-gray-600">0个未匹配项</span>
            </div>
            <button id="copyUnmappedHint" class="bg-white/5 hover:bg-white/10 text-gray-300 border border-white/10 px-4 py-1.5 rounded-full text-xs font-semibold transition-all">
                📋 复制未映射列表
            </button>
        </div>

        <div id="unmappedArea" class="unmapped-list relative z-10">
            <span class="text-gray-500">暂无未映射颜色，转换后将显示需要补充的颜色词</span>
        </div>

        <div class="mt-6 bg-blue-900/20 border border-blue-500/20 rounded-xl p-4 text-xs text-blue-300 leading-relaxed relative z-10 flex flex-col gap-2">
            <div>🎨 <strong>新增映射规则一览</strong> &nbsp;|&nbsp; 🍾 Champagne→Red &nbsp;|&nbsp; 🟡 单个字母 A/B/C... → Multicolor &nbsp;|&nbsp; 📝 color/colorful/mul/as show/as shown → Multicolor</div>
            <div>🍷 Wine→Red &nbsp;|&nbsp; ❌ balck→Black &nbsp;|&nbsp; ⚪ whtie→White &nbsp;|&nbsp; 🔄 while→White</div>
            <div>🌈 同时保留原有模糊匹配: Multiple*, multicolour*, Mixed color*, Multicolor* → Multicolor</div>
        </div>
        
        <div class="mt-3 bg-white/5 border border-white/10 rounded-xl p-3 text-xs text-gray-400 relative z-10">
            💡 提示：“未映射颜色”即未命中精确映射表且未命中模糊规则的颜色（已去重）。您可据此扩充映射库。
        </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10 text-center text-gray-500 text-xs tracking-widest uppercase">
        ✅ 精确匹配优先，其次模糊匹配。未匹配项原样保留集中展示。<br><br>
        &copy; 2026 GE32 AEROSPACE & AI. DESIGNED FOR THE NEXT ERA.
    </div>
</div>

<script>
    // --------------------------------------------------------------
    // 0. 星空背景生成逻辑 (新增)
    // --------------------------------------------------------------
    function createStars() {
        const container = document.getElementById('stars');
        const starCount = 150;
        for (let i = 0; i < starCount; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            const size = Math.random() * 2.5 + 'px';
            star.style.width = size;
            star.style.height = size;
            star.style.left = Math.random() * 100 + '%';
            star.style.top = Math.random() * 100 + '%';
            star.style.setProperty('--duration', Math.random() * 3 + 2 + 's');
            container.appendChild(star);
        }
    }

    // --------------------------------------------------------------
    // 1. 原始精确映射表（完全保留原有逻辑）
    // --------------------------------------------------------------
    const RAW_COLOR_MAP = {
        "mint green": "Green",
        "army green": "Green",
        "light green": "Green",
        "dark green": "Green",
        "grean": "Green",
        "greem": "Green",
        "gteen": "Green",
        "green ": "Green",
        " green": "Green",
        "rose gold": "Gold",
        "rosegold": "Gold",
        "rose-gold": "Gold",
        "sky blue": "Blue",
        "light blue": "Blue",
        "light bule": "Blue",
        "light b lue": "Blue",
        "dark blue": "Blue",
        "navy": "Blue",
        "navy blue": "Blue",
        "bleu": "Blue",
        "bule": "Blue",
        "bluw": "Blue",
        "coffee": "Brown",
        "khaki": "Brown",
        "brown": "Brown",
        "browm": "Brown",
        "broun": "Brown",
        "brawn": "Brown",
        "watermelon red": "Red",
        "watermellon red": "Red",
        "redd": "Red",
        "red ": "Red",
        "sliver": "Silver",
        "silvery": "Silver",
        "silver,clear": "Silver",
        "silverclear": "Silver",
        "siver": "Silver",
        "silvre": "Silver",
        "dark gray": "Gray",
        "dark grey": "Gray",
        "grey": "Gray",
        "gray": "Gray",
        "graay": "Gray",
        "graey": "Gray",
        "transparent": "Clear",
        "transparant": "Clear",
        "transperent": "Clear",
        "transperant": "Clear",
        "clear": "Clear",
        "clearr": "Clear",
        "clera": "Clear",
        "black": "Black",
        "blak": "Black",
        "blck": "Black",
        "white": "White",
        "whit": "White",
        "wite": "White",
        "yellow": "Yellow",
        "yello": "Yellow",
        "yelow": "Yellow",
        "orange": "Orange",
        "orenge": "Orange",
        "orng": "Orange",
        "pink": "Pink",
        "pinc": "Pink",
        "peenk": "Pink",
        "purple": "Purple",
        "purpel": "Purple",
        "purpple": "Purple",
        "violet": "Purple",
        "Champagne": "Pink",
        "champagne": "Pink",
        "Wine": "Red",
        "wine": "Red",
        "balck": "Black",
        "whtie": "White",
        "while": "White",
        "color": "Multicolor",
        "colorful": "Multicolor",
        "mul": "Multicolor",
        "as show": "Multicolor",
        "as shown": "Multicolor",
    };

    function buildExactMap(rawMap) {
        const map = new Map();
        for (const [rawKey, targetColor] of Object.entries(rawMap)) {
            const normalizedKey = rawKey.trim().toLowerCase();
            map.set(normalizedKey, targetColor);
        }
        return map;
    }

    const exactLookupMap = buildExactMap(RAW_COLOR_MAP);

    // --------------------------------------------------------------
    // 2. 模糊匹配规则 (完全保留原有逻辑)
    // --------------------------------------------------------------
    const fuzzyRules = [
        { regex: /^[a-z]$/i, target: "Multicolor" },
        { regex: /^multiple[a-z]*$/i, target: "Multicolor" },
        { regex: /^multicolour[a-z]*$/i, target: "Multicolor" },
        { regex: /^multicolor[a-z]*$/i, target: "Multicolor" },
        { regex: /^mixed\s*colou?r[a-z]*$/i, target: "Multicolor" },
        { regex: /^mixedcolou?r[a-z]*$/i, target: "Multicolor" },
        { regex: /^mixed\s+colou?rs?[a-z]*$/i, target: "Multicolor" },
        { regex: /^mixed[\s\-_]?colou?r[a-z]*$/i, target: "Multicolor" },
        { regex: /^mixed\s+colors?[a-z]*$/i, target: "Multicolor" }
    ];

    function applyFuzzyMatch(trimmedLower) {
        for (const rule of fuzzyRules) {
            if (rule.regex.test(trimmedLower)) {
                return rule.target;
            }
        }
        return null;
    }

    function convertColors(rawText) {
        const lines = rawText.split(/\r?\n/);
        const outputLines = [];
        const unmappedStats = new Map();

        for (let originalLine of lines) {
            const rawLine = originalLine;
            const trimmedLine = rawLine.trim();
            
            if (trimmedLine === "") {
                outputLines.push("");
                continue;
            }

            const normalizedInput = trimmedLine.toLowerCase();
            
            let mappedColor = exactLookupMap.get(normalizedInput);
            let isMatched = mappedColor !== undefined;
            
            if (!isMatched) {
                const fuzzyResult = applyFuzzyMatch(normalizedInput);
                if (fuzzyResult !== null) {
                    mappedColor = fuzzyResult;
                    isMatched = true;
                }
            }
            
            if (isMatched && mappedColor) {
                outputLines.push(mappedColor);
            } else {
                outputLines.push(rawLine);
                const key = normalizedInput;
                const existing = unmappedStats.get(key);
                if (existing) {
                    existing.count += 1;
                } else {
                    unmappedStats.set(key, {
                        display: trimmedLine,
                        count: 1,
                        originalSample: rawLine
                    });
                }
            }
        }
        return { outputLines, unmappedStats };
    }

    // ---------- UI 更新逻辑 (样式适配星空主题) ----------
    function updateUI() {
        const inputText = document.getElementById('inputColors').value;
        const { outputLines, unmappedStats } = convertColors(inputText);
        
        const outputTextarea = document.getElementById('outputColors');
        outputTextarea.value = outputLines.join('\n');
        
        const unmappedArea = document.getElementById('unmappedArea');
        const unmappedCountSpan = document.getElementById('unmappedCount');
        const unmappedSize = unmappedStats.size;
        unmappedCountSpan.textContent = `${unmappedSize} 个未匹配颜色词`;
        
        if (unmappedSize === 0) {
            // 针对暗黑模式修改了文字颜色
            unmappedArea.innerHTML = '<span class="text-green-400">✅ 所有颜色均已在映射表或模糊规则中！无未匹配项。</span>';
        } else {
            let itemsHtml = '';
            for (let [normKey, info] of unmappedStats.entries()) {
                const displayWord = info.display;
                const times = info.count;
                const timesText = times > 1 ? ` (${times}次)` : '';
                itemsHtml += `<span class="unmapped-item" title="标准化值: ${normKey} · 出现${times}次">${escapeHtml(displayWord)}${timesText}</span>`;
            }
            // 针对暗黑模式修改了文字颜色
            unmappedArea.innerHTML = `<div class="mb-2 text-yellow-500 font-medium text-sm">🔍 以下颜色未定义任何映射 (保留原值，建议添加到颜色库):</div><div>${itemsHtml}</div>`;
        }
    }

    function escapeHtml(str) {
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    // 复制转换结果
    async function copyOutput() {
        const outputTextarea = document.getElementById('outputColors');
        const textToCopy = outputTextarea.value;
        if (!textToCopy.trim() && outputTextarea.value === "") {
            alert("暂无转换结果，请先输入颜色并点击「开始转换」");
            return;
        }
        try {
            await navigator.clipboard.writeText(textToCopy);
            const copyBtn = document.getElementById('copyBtn');
            const originalText = copyBtn.innerHTML;
            copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> ✅ 已复制！';
            copyBtn.classList.add('copy-success');
            setTimeout(() => {
                copyBtn.innerHTML = originalText;
                copyBtn.classList.remove('copy-success');
            }, 1500);
        } catch (err) {
            alert("复制失败，可手动选中复制");
        }
    }

    // 复制未映射列表
    async function copyUnmappedList() {
        const inputText = document.getElementById('inputColors').value;
        const { unmappedStats } = convertColors(inputText);
        if (unmappedStats.size === 0) {
            alert("没有未映射的颜色，列表为空");
            return;
        }
        let lines = [];
        for (let [_, info] of unmappedStats.entries()) {
            const displayWord = info.display;
            const count = info.count;
            lines.push(`${displayWord}${count > 1 ? ` (出现${count}次)` : ''}`);
        }
        const textToCopy = lines.join('\n');
        try {
            await navigator.clipboard.writeText(textToCopy);
            const hintBtn = document.getElementById('copyUnmappedHint');
            const oldHtml = hintBtn.innerHTML;
            hintBtn.innerHTML = '📋 已复制！';
            setTimeout(() => {
                hintBtn.innerHTML = oldHtml;
            }, 1200);
        } catch(e) {
            alert("复制失败，可手动选取列表文字");
        }
    }

    function clearAll() {
        document.getElementById('inputColors').value = '';
        document.getElementById('outputColors').value = '';
        document.getElementById('unmappedArea').innerHTML = '<span class="text-gray-500">暂无未映射颜色，转换后将显示需要补充的颜色词</span>';
        document.getElementById('unmappedCount').textContent = '0个未匹配项';
    }

    function setExampleData() {
        const example = `mint green
rose gold
champagne
A
B
C
X
color
colorful
as show
As shown
mul
Wine
balck
whtie
while
MulticolorXYZ
Mixed colors
multicolourExtra
multipleABC
navy blue
bluw
light b lue
golden
army green
grean
silver,clear
pinc
coffee
violet
unknownTest
singleLetter: D
extra: whileTestShouldBeWhite`;
        document.getElementById('inputColors').value = example;
        updateUI();
    }

    // 绑定事件与初始化
    document.addEventListener('DOMContentLoaded', () => {
        createStars(); // 初始化星空动画
        
        const convertBtn = document.getElementById('convertBtn');
        const copyBtn = document.getElementById('copyBtn');
        const clearBtn = document.getElementById('clearBtn');
        const copyUnmappedBtn = document.getElementById('copyUnmappedHint');
        
        convertBtn.addEventListener('click', updateUI);
        copyBtn.addEventListener('click', copyOutput);
        clearBtn.addEventListener('click', clearAll);
        copyUnmappedBtn.addEventListener('click', copyUnmappedList);
        
        if (document.getElementById('inputColors').value.trim() === "") {
            setExampleData();
        } else {
            updateUI(); 
        }
        
        const inputArea = document.getElementById('inputColors');
        inputArea.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                updateUI();
            }
        });
    });
</script>
</body>
</html>